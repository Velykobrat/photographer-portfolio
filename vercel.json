{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/home",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/journal",
      "permanent": true
    },
    {
      "source": "/uk",
      "destination": "/uk/home",
      "permanent": true
    },
    {
      "source": "/uk/blog",
      "destination": "/uk/journal",
      "permanent": true
    }
  ]
}
