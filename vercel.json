{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/collections",
      "destination": "/index.html"
    },
    {
      "source": "/collections/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/journal",
      "destination": "/index.html"
    },
    {
      "source": "/journal/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|WhatsApp|Slackbot|Discordbot).*"
        }
      ],
      "destination": "/api/social-preview?slug=:slug"
    },
    {
      "source": "/journal/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/contacts",
      "destination": "/index.html"
    }
  ]
}